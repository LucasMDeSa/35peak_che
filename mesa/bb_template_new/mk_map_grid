#!/bin/bash
set -euo pipefail
#
# mk_map_grid — Create a map grid for CHE window mapping
#
# Builds a full dense M×P grid under map/ with MS-only stopping conditions
# (center h1 <= 1d-6 OR surface he4 >= 0.7, whichever comes first) and a
# 4-hour default walltime (MAP_ARRAY_WALLTIME).  Uses symlinks to a pre-compiled map_template/ to avoid
# duplicating the ~57 MB star binary across thousands of model directories.
#
# Usage:  ./mk_map_grid [--dry-run]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
# Parent grid.conf values are baked into map/grid.conf in Step 5.
GRID_ROOT="$SCRIPT_DIR" load_grid_conf

MAP_DIR="$SCRIPT_DIR/map"
# Default walltime written to map/grid.conf (MS-only runs)
MAP_ARRAY_WALLTIME="04:00:00"
MAP_TEMPLATE="$MAP_DIR/map_template"

DRY_RUN=false
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        *) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

if [ ! -f "$SCRIPT_DIR/map_run_star_extras.f90" ]; then
    echo "ERROR: map_run_star_extras.f90 not found in $SCRIPT_DIR" >&2
    exit 1
fi

if [ -d "$MAP_DIR" ]; then
    echo "ERROR: $MAP_DIR already exists. Remove it first to regenerate." >&2
    exit 1
fi

PHYSICS_ID=$(get_physics_id)

# Grid dimensions
n_z=$(grep -cvE '^[[:space:]]*(#|$)' "$SCRIPT_DIR/z_div_zsun_grid")
n_m=$(grep -c . "$SCRIPT_DIR/ZdivZsun_template/mass_grid")
n_p=$(grep -c . "$SCRIPT_DIR/ZdivZsun_template/period_grid")
n_z_ignored=0
if [ -f "$SCRIPT_DIR/z_ignore_grid" ]; then
    n_z_ignored=$(grep -cvE '^[[:space:]]*(#|$)' "$SCRIPT_DIR/z_ignore_grid") || n_z_ignored=0
fi
n_z_active=$((n_z - n_z_ignored))
n_total=$((n_z_active * n_m * n_p))

echo "Map grid summary:"
echo "  Physics set: $(basename "$SCRIPT_DIR") (ID: $PHYSICS_ID)"
echo "  Metallicities: $n_z_active active (of $n_z)"
echo "  Masses: $n_m"
echo "  Periods: $n_p"
echo "  Total models: $n_total"
echo "  Walltime per model: ${MAP_ARRAY_WALLTIME}"

if $DRY_RUN; then
    echo ""
    echo "Dry run — nothing created."
    exit 0
fi

echo ""

# ── Step 1: Create map/map_template/ ────────────────────────────────────────
echo "Step 1: Creating map template..."
mkdir -p "$MAP_TEMPLATE"
copy_without_build "$SCRIPT_DIR/ZdivZsun_template/template/MESA_input_src/" "$MAP_TEMPLATE/"

cp "$SCRIPT_DIR/map_run_star_extras.f90" "$MAP_TEMPLATE/src/run_star_extras.f90"

inlist_both_tpl="$MAP_TEMPLATE/inlist_both"

# Comment out c12 stopping condition
sed -i "s|^xa_central_lower_limit_species(1) = 'c12'|! Map grid: xa_central_lower_limit_species(1) = 'c12'|" "$inlist_both_tpl"
sed -i "s|^xa_central_lower_limit(1) = 1.0d-6|! Map grid: xa_central_lower_limit(1) = 1.0d-6|" "$inlist_both_tpl"

# Add h1 stopping condition after the commented block
sed -i "/^! Map grid: xa_central_lower_limit(1) = 1.0d-6/a\\
xa_central_lower_limit_species(1) = 'h1'\\
xa_central_lower_limit(1) = 1.0d-6" "$inlist_both_tpl"

# Comment out required_termination_code_string (fe_core_infall doesn't apply)
sed -i "s|^required_termination_code_string(1)|! Map grid: required_termination_code_string(1)|" "$inlist_both_tpl"

patch_inline "$inlist_both_tpl" save_model_filename "'map_terminal.mod'"
patch_inline "$inlist_both_tpl" filename_for_profile_when_terminate "'LOGS/map_terminal.data'"

# Change nuclear network in inlist1
inlist1_tpl="$MAP_TEMPLATE/inlist1"
patch_inline "$inlist1_tpl" new_net_name "'approx21_cr56.net'"

echo "  Map template created at $MAP_TEMPLATE"

# ── Step 2: Compile star binary ─────────────────────────────────────────────
echo "Step 2: Compiling MESA binary..."
(cd "$MAP_TEMPLATE" && ./mk)
if [ ! -f "$MAP_TEMPLATE/star" ]; then
    echo "ERROR: Compilation failed — star binary not found" >&2
    exit 1
fi
echo "  Binary compiled successfully"

# ── Step 3 & 4: Create L1/L2/L3 dirs ────────────────────────────────────────
echo "Step 3-4: Creating grid directories..."

run_grid="$MAP_DIR/run_grid"
: > "$run_grid"

mass_grid="$SCRIPT_DIR/ZdivZsun_template/mass_grid"
period_grid="$SCRIPT_DIR/ZdivZsun_template/period_grid"

z_counter=0
while read -r z_div_zsun; do
    z_id=$(printf "%02d" "$z_counter")

    if is_z_ignored "$z_div_zsun"; then
        echo "  Skipping ignored metallicity: Z/Zsun=$z_div_zsun (ID: $z_id)"
        z_counter=$((z_counter+1))
        continue
    fi

    z=$(echo "scale=8; $z_div_zsun * $ZSUN" | bc -l)
    z_str=$(fortran_d "$z" "%.2e")
    z_div_zsun_id=$(fortran_d "$z_div_zsun" "%.0e")
    l1_dir="${PHYSICS_ID}${z_id}_ZdivZsun_${z_div_zsun_id}"
    l1_path="$MAP_DIR/$l1_dir"

    mkdir -p "$l1_path"

    # Per-L1 inlist_both (copy from map template, patch Z)
    cp "$inlist_both_tpl" "$l1_path/inlist_both"
    patch_inline "$l1_path/inlist_both" new_Z "${z_str}"
    patch_inline "$l1_path/inlist_both" Zbase "${z_str}"

    m_counter=0
    while read -r mass; do
        m_counter=$((m_counter+1))
        m_id=$(printf "%03d" "$m_counter")
        l2_dir="${m_id}_m${mass}"
        l2_path="$l1_path/$l2_dir"
        mkdir -p "$l2_path"

        while read -r p_d; do
            # Period (days) to omega (rad/s) — same formula as gen_grid_file
            p_s=$(echo "scale=8; $p_d * 86400" | bc -l)
            omega=$(echo "scale=8; 2 * 4*a(1) / $p_s" | bc -l)

            # Fortran d-notation (same as mk_mesa_inputs)
            mass_d=$(printf "%.3e" "$mass" | sed 's/e/d/')
            omega_d=$(printf "%.3e" "$omega" | sed 's/e/d/')
            period_d=$(printf "%.3e" "$p_d" | sed 's/e/d/')

            l3_dir="m${mass_d}_p${period_d}_w${omega_d}"
            l3_path="$l2_path/$l3_dir"
            mkdir -p "$l3_path"

            # Symlinks to map_template
            ln -s ../../../map_template/star              "$l3_path/star"
            ln -s ../../../map_template/rn                "$l3_path/rn"
            ln -s ../../../map_template/re                "$l3_path/re"
            ln -s ../../../map_template/mk                "$l3_path/mk"
            ln -s ../../../map_template/clean             "$l3_path/clean"
            ln -s ../../../map_template/inlist            "$l3_path/inlist"
            ln -s ../../../map_template/inlist_pgstar     "$l3_path/inlist_pgstar"
            ln -s ../../../map_template/history_columns.list "$l3_path/history_columns.list"
            ln -s ../../../map_template/profile_columns.list "$l3_path/profile_columns.list"

            # Symlink to L1's inlist_both
            ln -s ../../inlist_both "$l3_path/inlist_both"

            # Real file: inlist1 (per-model mass/omega)
            cp "$inlist1_tpl" "$l3_path/inlist1"
            patch_inline "$l3_path/inlist1" initial_mass "${mass_d}"
            patch_inline "$l3_path/inlist1" new_omega "${omega_d} ! rad s-1"

            # Output directory
            mkdir -p "$l3_path/LOGS"

            # Run grid entry (relative to map/)
            echo "(cd $l1_dir/$l2_dir/$l3_dir ; ./rn) &> $l1_dir/$l2_dir/$l3_dir.log" >> "$run_grid"

        done < "$period_grid"
    done < "$mass_grid"

    echo "  Created L1: $l1_dir (Z/Zsun=$z_div_zsun, Z=$z_str)"
    z_counter=$((z_counter+1))
done < "$SCRIPT_DIR/z_div_zsun_grid"

n_entries=$(wc -l < "$run_grid")
echo "  Generated run_grid with $n_entries entries"

# ── Step 5: Dispatch infrastructure ──────────────────────────────────────────
echo "Step 5: Setting up dispatch infrastructure..."

cat > "$MAP_DIR/grid.conf" <<GRIDCONF
# Map grid configuration — inherits from parent grid.conf, overrides for MS-only runs.
GRID_EMAIL="\${GRID_EMAIL:-${GRID_EMAIL}}"
MESA_ACTIVATE_CMD="\${MESA_ACTIVATE_CMD:-${MESA_ACTIVATE_CMD}}"
SLURM_PARTITION_SINGLE="\${SLURM_PARTITION_SINGLE:-${SLURM_PARTITION_SINGLE}}"
CPUS_PER_TASK="\${CPUS_PER_TASK:-8}"
ARRAY_WALLTIME="\${ARRAY_WALLTIME:-${MAP_ARRAY_WALLTIME}}"
ARRAY_CONCURRENCY="\${ARRAY_CONCURRENCY:-120}"
MAX_ARRAY_TASKS="\${MAX_ARRAY_TASKS:-${MAX_ARRAY_TASKS}}"
GRIDCONF

ln -s ../dispatch_grid "$MAP_DIR/dispatch_grid"
ln -s ../lib "$MAP_DIR/lib"
ln -s ../z_div_zsun_grid "$MAP_DIR/z_div_zsun_grid"
[ -f "$SCRIPT_DIR/z_ignore_grid" ] && ln -s ../z_ignore_grid "$MAP_DIR/z_ignore_grid"
cp "$SCRIPT_DIR/chain_submit.slurm" "$MAP_DIR/chain_submit.slurm"

echo ""
echo "Map grid created successfully in $MAP_DIR"
echo "  $n_entries models ready to dispatch"
echo ""
echo "Next steps:"
echo "  cd map"
echo "  ./dispatch_grid [--dry-run]"
echo "  # If split into multiple parts, chain them:"
echo "  sbatch chain_submit.slurm [--first-wait N] [--last N]"
