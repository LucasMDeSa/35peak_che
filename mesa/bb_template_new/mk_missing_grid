#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/common.sh"

INPUT_Z_GRID="z_div_zsun_grid"
INPUT_M_GRID="ZdivZsun_template/mass_grid"
INPUT_P_GRID="ZdivZsun_template/period_grid"

OUTPUT_RUN_FILE="run_missing_grid"
OUTPUT_LOG="missing_models.log"

TEMPLATE_L1="ZdivZsun_template"

PHYSICS_ID=$(get_physics_id)

rm -f "$OUTPUT_RUN_FILE" "$OUTPUT_LOG"
touch "$OUTPUT_RUN_FILE" "$OUTPUT_LOG"

echo "Starting missing model detection for ID: $PHYSICS_ID"
echo "Scanning grid structure..."

MISSING_COUNT=0
CNT_Z=0

while read -r z_div_zsun; do
    ID_Z=$(printf "%02d" "$CNT_Z")

    if is_z_ignored "$z_div_zsun"; then
        echo "Skipping ignored metallicity: $z_div_zsun (ID: $ID_Z)"
        CNT_Z=$((CNT_Z + 1))
        continue
    fi

    Z_VAL=$(echo "scale=8; $z_div_zsun * $ZSUN" | bc -l)
    Z_STR=$(fortran_d "$Z_VAL" "%.2e")
    Z_SUFFIX=$(fortran_d "$z_div_zsun" "%.0e")

    DIR_L1="${PHYSICS_ID}${ID_Z}_ZdivZsun_${Z_SUFFIX}"

    # Use per-L1 mass_grid override if present (sparse grids)
    if [ -f "$DIR_L1/mass_grid" ]; then
        EFF_M_GRID="$DIR_L1/mass_grid"
    else
        EFF_M_GRID="$INPUT_M_GRID"
    fi

    CNT_M=0

    while read -r MASS; do
        CNT_M=$((CNT_M + 1))
        ID_M=$(printf "%03d" "$CNT_M")
        DIR_L2="${DIR_L1}/${ID_M}_m${MASS}"

        # Use per-mass period_grid override if present (sparse grids)
        if [ -f "$DIR_L1/period_grid.${MASS}" ]; then
            EFF_P_GRID="$DIR_L1/period_grid.${MASS}"
        elif [ -f "$DIR_L1/period_grid" ]; then
            EFF_P_GRID="$DIR_L1/period_grid"
        else
            EFF_P_GRID="$INPUT_P_GRID"
        fi

        while read -r P_DAYS; do
            P_SEC=$(echo "scale=8; $P_DAYS * 86400" | bc -l)
            OMEGA=$(echo "scale=8; 2 * 4*a(1) / $P_SEC" | bc -l)

            STR_MASS=$(fortran_d "$MASS" "%.3e")
            STR_OMEGA=$(fortran_d "$OMEGA" "%.3e")
            STR_PDAYS=$(fortran_d "$P_DAYS" "%.3e")

            DIR_L3="${DIR_L2}/m${STR_MASS}_p${STR_PDAYS}_w${STR_OMEGA}"

            if [ ! -d "$DIR_L3" ]; then

                if [ ! -d "$DIR_L1/template" ]; then
                    echo "Reconstructing Metallicity folder: $DIR_L1" >> "$OUTPUT_LOG"
                    mkdir -p "$DIR_L1"
                    copy_without_build "$TEMPLATE_L1/" "$DIR_L1/"
                    INLIST_BOTH="$DIR_L1/template/MESA_input_src/inlist_both"
                    patch_inline "$INLIST_BOTH" new_Z "${Z_STR}"
                    patch_inline "$INLIST_BOTH" Zbase "${Z_STR}"
                fi

                if [ ! -d "$DIR_L2/MESA_input_src" ]; then
                    echo "Reconstructing Mass folder: $DIR_L2" >> "$OUTPUT_LOG"
                    mkdir -p "$DIR_L2"
                    copy_without_build "$DIR_L1/template/" "$DIR_L2/"
                    if [ -f "$DIR_L1/period_grid.${MASS}" ]; then
                        cp "$DIR_L1/period_grid.${MASS}" "$DIR_L2/period_grid"
                    else
                        cp "$DIR_L1/period_grid" "$DIR_L2/"
                    fi
                    patch_inline "$DIR_L2/gen_grid_file" m "${MASS}"
                fi

                echo "Creating missing Model: $DIR_L3" >> "$OUTPUT_LOG"
                mk_thin_model_dir "$DIR_L2/MESA_input_src" "$DIR_L3" "${STR_MASS}" "${STR_OMEGA}"

                echo "(cd $DIR_L3 ; ./rn) &> $DIR_L3.log" >> "$OUTPUT_RUN_FILE"
                MISSING_COUNT=$((MISSING_COUNT + 1))
            fi

        done < "$EFF_P_GRID"
    done < "$EFF_M_GRID"

    CNT_Z=$((CNT_Z + 1))
done < "$INPUT_Z_GRID"

echo "Done. Detected and generated $MISSING_COUNT missing models."
echo "See $OUTPUT_LOG for details."
echo "Run list generated at: $OUTPUT_RUN_FILE"
